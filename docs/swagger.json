{
    "swagger": "2.0",
    "info": {
        "description": "Live spreadsheet bookings are publicly available. Optional Google OAuth sign-in sets a one-hour HttpOnly authentication cookie.",
        "title": "Chula Room Booking API",
        "contact": {},
        "version": "0.1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/v1/admin/sheet-bookings": {
            "get": {
                "description": "Reads a 60-second cached Sheet snapshot without authentication.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sheet-bookings"
                ],
                "summary": "List public spreadsheet bookings",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Calendar year; requires month",
                        "name": "year",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Month 1-12; requires year",
                        "name": "month",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "ENG building name",
                        "name": "building",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "approved, cancelled, submitted, timeline, needs_revision, or conflicted",
                        "name": "status",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Page number, default 1",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Page size, default 20, maximum 100",
                        "name": "page_size",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/sheetbooking.Page"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/sheetbooking.errorResponse"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "$ref": "#/definitions/sheetbooking.errorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/admin/sheet-bookings/calendar": {
            "get": {
                "description": "Conflicted counts active bookings overlapping the same room and daily time window. No authentication is required.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sheet-bookings"
                ],
                "summary": "Public monthly spreadsheet booking calendar",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Calendar year",
                        "name": "year",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Month 1-12",
                        "name": "month",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "ENG building name",
                        "name": "building",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/sheetbooking.CalendarResult"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/sheetbooking.errorResponse"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "$ref": "#/definitions/sheetbooking.errorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/admin/sheet-bookings/weekly": {
            "get": {
                "description": "Uses the 60-second cached Sheet snapshot without authentication. Dates are inclusive and use Bangkok time.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "sheet-bookings"
                ],
                "summary": "Public weekly spreadsheet room schedule",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Start date YYYY-MM-DD; defaults to today in Bangkok",
                        "name": "start_date",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "End date YYYY-MM-DD; defaults to six days after start_date",
                        "name": "end_date",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "ENG 3, ENG 100, or ENG 4",
                        "name": "building",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/sheetbooking.WeeklyResult"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/sheetbooking.errorResponse"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "$ref": "#/definitions/sheetbooking.errorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/auth/logout": {
            "post": {
                "description": "Clears the application auth cookie; an already issued JWT expires at its original time.",
                "tags": [
                    "auth"
                ],
                "summary": "Log out",
                "responses": {
                    "204": {
                        "description": "No Content"
                    }
                }
            }
        },
        "/api/v1/auth/me": {
            "get": {
                "description": "Validates the JWT and loads the current active user from PostgreSQL; role changes apply immediately.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Get current user",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/user.User"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/auth.errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/auth.errorResponse"
                        }
                    }
                }
            }
        },
        "/auth/google/callback": {
            "get": {
                "description": "Redirects to FRONTEND_URL on success or /login?auth_error=code on failure. Never exposes a token in the URL or response body.",
                "tags": [
                    "auth"
                ],
                "summary": "Complete Google sign-in",
                "responses": {
                    "302": {
                        "description": "Found"
                    }
                }
            }
        },
        "/auth/google/login": {
            "get": {
                "description": "Sets a temporary state cookie and redirects to Google.",
                "tags": [
                    "auth"
                ],
                "summary": "Start Google sign-in",
                "responses": {
                    "302": {
                        "description": "Found"
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/auth.errorResponse"
                        }
                    }
                }
            }
        },
        "/auth/google/url": {
            "get": {
                "description": "Development only. The same browser must retain the temporary cookie when following auth_url.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Get Google authorization URL",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/auth.errorResponse"
                        }
                    }
                }
            }
        },
        "/healthz": {
            "get": {
                "description": "Returns ok while the process is running; does not query PostgreSQL.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Check liveness",
                "responses": {
                    "200": {
                        "description": "status: ok",
                        "schema": {
                            "$ref": "#/definitions/health.probeResponse"
                        }
                    }
                }
            }
        },
        "/readyz": {
            "get": {
                "description": "Returns ready when PostgreSQL is not configured; otherwise pings PostgreSQL with a two-second timeout.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Check readiness",
                "responses": {
                    "200": {
                        "description": "status: ready",
                        "schema": {
                            "$ref": "#/definitions/health.probeResponse"
                        }
                    },
                    "503": {
                        "description": "status: unavailable",
                        "schema": {
                            "$ref": "#/definitions/health.probeResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "auth.errorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        },
        "health.probeResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string"
                }
            }
        },
        "sheetbooking.Booking": {
            "type": "object",
            "properties": {
                "conflicted": {
                    "type": "boolean"
                },
                "end_date": {
                    "type": "string"
                },
                "end_time": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "room": {
                    "type": "string"
                },
                "start_date": {
                    "type": "string"
                },
                "start_time": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "sheetbooking.CalendarResult": {
            "type": "object",
            "properties": {
                "days": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/sheetbooking.Day"
                    }
                },
                "month": {
                    "type": "integer"
                },
                "year": {
                    "type": "integer"
                }
            }
        },
        "sheetbooking.Counts": {
            "type": "object",
            "properties": {
                "approved": {
                    "type": "integer"
                },
                "cancelled": {
                    "type": "integer"
                },
                "conflicted": {
                    "type": "integer"
                },
                "needs_revision": {
                    "type": "integer"
                },
                "submitted": {
                    "type": "integer"
                },
                "timeline": {
                    "type": "integer"
                }
            }
        },
        "sheetbooking.Day": {
            "type": "object",
            "properties": {
                "counts": {
                    "$ref": "#/definitions/sheetbooking.Counts"
                },
                "date": {
                    "type": "string"
                }
            }
        },
        "sheetbooking.Page": {
            "type": "object",
            "properties": {
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/sheetbooking.Booking"
                    }
                },
                "page": {
                    "type": "integer"
                },
                "page_size": {
                    "type": "integer"
                },
                "total": {
                    "type": "integer"
                }
            }
        },
        "sheetbooking.WeeklyBooking": {
            "type": "object",
            "properties": {
                "end_at": {
                    "type": "string"
                },
                "has_conflict": {
                    "type": "boolean"
                },
                "id": {
                    "type": "string"
                },
                "start_at": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                }
            }
        },
        "sheetbooking.WeeklyResult": {
            "type": "object",
            "properties": {
                "end_date": {
                    "type": "string"
                },
                "rooms": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/sheetbooking.WeeklyRoom"
                    }
                },
                "start_date": {
                    "type": "string"
                }
            }
        },
        "sheetbooking.WeeklyRoom": {
            "type": "object",
            "properties": {
                "bookings": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/sheetbooking.WeeklyBooking"
                    }
                },
                "building": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "sheetbooking.errorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        },
        "user.User": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string"
                },
                "first_name": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "last_name": {
                    "type": "string"
                },
                "role": {
                    "type": "string"
                }
            }
        }
    }
}