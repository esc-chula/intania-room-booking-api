APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
# Optional for the current public Sheets API. Set this when enabling PostgreSQL-backed auth.
DATABASE_URL=
# Optional when auth is disabled. Generate an independent 32-byte secret when enabling auth.
JWT_SECRET=
# Set this to an eligible Chula Google account before `make bootstrap-admin`.
BOOTSTRAP_ADMIN_EMAIL=
# Optional, comma-separated student IDs. Example: 6730000021,6720000021.
OS_STUDENT_IDS=
GOOGLE_SPREADSHEET_ID=replace-with-spreadsheet-id
GOOGLE_SHEET_RANGE='จองห้อง!A9:AM'
# Optional locally: point to an external service-account JSON file.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/credentials.json
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_CONNECT_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
FRONTEND_URL=http://localhost:3000
# Use none for cross-site HTTPS frontend/API; use lax for same-site deployments.
AUTH_COOKIE_SAME_SITE=lax
GOOGLE_ALLOWED_DOMAIN=student.chula.ac.th
GOOGLE_ALLOWED_SUFFIX=21
