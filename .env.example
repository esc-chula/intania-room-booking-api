# Required for the Sheets API: select the spreadsheet and range.
GOOGLE_SPREADSHEET_ID=replace-with-spreadsheet-id
GOOGLE_SHEET_RANGE='จองห้อง!A9:AM'

# Optional: local defaults are shown; unset variables use these defaults.
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s

# Optional: ADC uses gcloud login/impersonation or an attached identity by default.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/credentials.json

# Required to authenticate requests to the Sheets endpoints.
DATABASE_URL=
# Use at least 32 non-padding bytes.
JWT_SECRET=
# Optional database tuning (used when DATABASE_URL is set).
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_CONNECT_TIMEOUT=5s

# Required for users to sign in with Google; both must be set together.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional OAuth/auth settings; local defaults are shown.
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
FRONTEND_URL=http://localhost:3000
# Use none for cross-site HTTPS; lax is the development default.
AUTH_COOKIE_SAME_SITE=lax
GOOGLE_ALLOWED_DOMAIN=student.chula.ac.th
GOOGLE_ALLOWED_SUFFIX=21

# Only needed for make bootstrap-admin when no ADMIN exists.
BOOTSTRAP_ADMIN_EMAIL=
# Optional for make bootstrap-os; comma-separated numeric student IDs ending in 21.
OS_STUDENT_IDS=
