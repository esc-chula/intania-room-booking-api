APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
DATABASE_URL=postgres://chula:localdev@localhost:5432/chula_room_booking?sslmode=disable
# Local development only; use an independently generated random secret in production.
JWT_SECRET=local-development-only-jwt-secret-change-in-production
# Used only by `make bootstrap-admin`. Do not commit a real password.
BOOTSTRAP_ADMIN_NAME='Admin'
BOOTSTRAP_ADMIN_PASSWORD=
GOOGLE_SPREADSHEET_ID=replace-with-spreadsheet-id
GOOGLE_SHEET_RANGE='จองห้อง!A9:AM'
# Optional locally: point to an external service-account JSON file.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/credentials.json
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_CONNECT_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s
